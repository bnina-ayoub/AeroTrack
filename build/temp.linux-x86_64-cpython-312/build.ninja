ninja_required_version = 1.3
cxx = ccache c++

cflags = -fno-strict-overflow -Wsign-compare -DNDEBUG -g -O2 -Wall -fPIC -I/home/bninaos/UAV-Tracking-Project/AeroTrack/venv/lib/python3.12/site-packages/numpy/_core/include -I/home/bninaos/UAV-Tracking-Project/AeroTrack/venv/include -I/usr/include/python3.12 -c
post_cflags = -DTORCH_API_INCLUDE_EXTENSION_H -DTORCH_EXTENSION_NAME=cython_nwd -std=c++20
cuda_dlink_post_cflags = 
sycl_dlink_post_cflags = 
ldflags = 

rule compile
  command = $cxx -MMD -MF $out.d $cflags -c $in -o $out $post_cflags
  depfile = $out.d
  deps = gcc







